---
const { url, title, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="blogPost">
  <a href={url}>{title}</a>
  <p>{formattedDate}</p>
</div>

<style>
  .blogPost {
    padding: 40px 10px;
    background-color: #d08ee0;
    width: 80%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 2rem auto;
    border-radius: 20px;
    border-style: solid;
    border-width: 3px;
    border-color: #af64c2;
    position: relative;
    transition: transform 0.2 ease;
    min-width: 300px;
  }

  .blogPost a {
    text-decoration: none;
    color: inherit;
  }

  .blogPost a::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blogPost p {
    position: absolute;
    top: 0em;
    left: 0.5em;
    font-size: 0.7em;
    color: #4d4a4e;
  }

  .blogPost:hover {
    transform: translate(2px, -2px);
  }
</style>
