---
const { platform, username, url } = Astro.props;

const platformEmojis: Record<string, string> = {
  github: "🐙",
  instagram: "📸",
  linkedin: "👔",
  openprocessing: "🎨",
};

const icon = platformEmojis[platform] || "🌐";
const linkText = `${icon} ${platform}`;
---

<a href={url ? url : `https://www.${platform}.com/${username}`}>
  {linkText}
</a>

<style>
  a {
    padding: 0.5rem 2rem;
    color: white;
    background-color: #7872cf;
    text-decoration: none;
    width: 100%;
    max-width: 40%;
    min-width: 213px;
    text-align: center;
    border-radius: 8px;
    box-sizing: border-box;
  }
</style>
