---
import { Icon } from "astro-icon/components";

const url = new URL(Astro.request.url);
const activeSearch = url.searchParams.get("search");
---

<div class="search-div">
  <h2>Search the Blog</h2>
  <form id="search-widget">
    <input
      type="search"
      id="search-widget-input"
      name="search"
      class="input"
      maxlength="20"
      placeholder="Search the blog..."
      required
      autocomplete="off"
    />
    <button type="submit" class="btn">
      <Icon name="mdi:magnify" width="18" height="18" />
    </button>
  </form>

  {
    activeSearch && (
      <div class="clearFilter">
        <button id="clearSearch">Clear Search ✖</button>
      </div>
    )
  }
</div>

<style>
  .search-div {
    background-color: #86c5bd;
    margin: 0 1.5em;
    border-radius: 0.5em;
    border: solid 3px #53ada1;
    padding: 0.5em 1em;
    width: 300px;
  }

  form {
    display: flex;
    gap: 0.5em;
  }

  .input {
    flex: 1;
    padding: 0.5em 0.75em;
    border: 2px solid #53ada1;
    border-radius: 0.5em;
    font-size: 1em;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em;
    border: 2px solid #53ada1;
    border-radius: 0.5em;
    min-width: 40px;
    cursor: pointer;
  }

  .btn:hover {
    background: #f0f0f0;
  }

  .btn svg {
    display: block;
  }

  .clearFilter {
    margin-top: 1em;
    text-align: center;
  }

  #clearSearch {
    background: #7a7676;
    color: white;
    padding: 0.5em 1em;
    border-radius: 0.5em;
    border: none;
    cursor: pointer;
    font-size: 0.85em;
  }

  #clearSearch:hover {
    background: #383838;
  }

  @media screen and (max-width: 1060px) {
    .search-div {
      margin-top: 1rem;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#search-widget");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const searchInput = form.querySelector<HTMLInputElement>('[name="search"]');
    const searchValue = searchInput?.value.trim() ?? "";

    const url = new URL(window.location.href);
    if (searchValue) url.searchParams.set("search", searchValue);
    else url.searchParams.delete("search");

    window.location.href = url.toString();
  });

  document
    .querySelector<HTMLButtonElement>("#clearSearch")
    ?.addEventListener("click", () => {
      const url = new URL(window.location.href);
      url.searchParams.delete("search");
      window.location.href = url.toString();
    });
</script>
