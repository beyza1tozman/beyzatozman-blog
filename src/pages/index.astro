---
import BaseLayout from "../layouts/BaseLayout.astro";
import Social from "../components/Social.astro";

const likes = [
  "smell of rain",
  "coffee",
  "desserts",
  "cats & other animals",
  "ramen, sushi, sarma, food in general",
  "fall & spring",
  "purple & green",
  "anime",
  "photography",
  "warm lighting",
  "fashion",
  "anything cute",
];

const pageTitle = "Beyza's Blog";
---

<BaseLayout pageTitle={pageTitle} class="home">
  <div class="home-content">
    <div class="sketch">
      <iframe
        id="p5-sketch-iframe"
        src="/sketch/index.html"
        width="400"
        height="400"
        loading="lazy"
      >
      </iframe>
    </div>

    <h1>/Hi! I am Beyza</h1>
    <div class="intro">
      <img src="/assets/beyza1.png" />
      <div class="paragraph">
        <p>
          I'm a software developer living in Ankara, Turkey. I really love
          reading other people's blogs, and they inspired me to build my own
          digital space.
        </p>
        <p>
          I plan on sharing my learnings and anything that interests me. Hope
          you enjoy your time here!
        </p>
      </div>
    </div>

    <p class="section-header">Hobbies</p>
    <p>
      reading, travelling, drawing, cooking, watching movies, sleeping,
      listening to music
    </p>

    <p class="section-header">Likes</p>
    <div class="things">
      {
        likes.map((item) => (
          <p>
            <span class="heart-bullet">𖹭</span> {item}
          </p>
        ))
      }
    </div>

    <div class="social">
      <p class="section-header">On the web</p>
      <Social platform="github" username="beyza1tozman" />
      <Social platform="instagram" username="loovely.days" />
      <Social
        url="https://www.linkedin.com/in/beyzatozman1/"
        platform="linkedin"
      />
      <Social
        url="https://openprocessing.org/user/482461/#sketches"
        platform="openprocessing"
      />
    </div>

    <p>
      My RSS feed:
      <a href="/rss.xml" class="RSS-styling">RSS</a>
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 80ch;
  }

  .home-content {
    margin: 0 2rem;
  }

  .sketch {
    display: block;
    text-align: center;
  }

  iframe {
    border: none;
    overflow: hidden;
    width: min(400px, 100%);
    height: auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .intro {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .intro img {
    width: 150px;
    height: auto;
    border-radius: 50%;
    border: 3px solid #e3bdec;
    flex-shrink: 0;
  }

  .paragraph {
    flex: 1;
  }

  @media screen and (max-width: 500px) {
    .intro {
      flex-direction: column;
      text-align: center;
    }

    .intro img {
      margin: 0 auto;
    }

    .paragraph {
      text-align: center;
    }
  }

  .section-header {
    font-weight: bold;
    font-size: 1.2rem;
    text-decoration: underline 4px;
    text-underline-offset: 8px;
  }

  .social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .things p {
    margin: 0;
    padding-left: 10px;
    line-height: 1.3;
    font-size: 15px;
    position: relative;
  }

  .heart-bullet {
    color: #ff9acb;
    margin-right: 6px;
    font-size: 14px;
  }

  .RSS-styling {
    text-decoration: none;
    font-weight: bold;
    color: #60a153;
  }
</style>
