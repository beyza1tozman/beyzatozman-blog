---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StarRating from "../../components/StarRating.astro";
import { getCollection } from "astro:content";

const pageTitle = "Books";

const allBooks = await getCollection("books");

const booksByYear = allBooks.reduce(
  (acc, book) => {
    const year = String(book.data.yearRead);
    acc[year] ??= [];
    acc[year].push(book);
    return acc;
  },
  {} as Record<string, typeof allBooks>
);

const sortedYears = Object.keys(booksByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout pageTitle={pageTitle} class="books">
  <div class="books-container">
    <h1 class="books-title">Books</h1>
    <div class="books-content">
      {
        sortedYears.map((year) => (
          <div class="year-group">
            <h2 class="year-header">{year} 📚</h2>
            <ul>
              {booksByYear[year]
                .sort(
                  (a, b) =>
                    b.data.fullDate.getTime() - a.data.fullDate.getTime()
                )
                .map((book) => (
                  <li>
                    <div class="line-content">
                      <a class="book-title" href={`/books/${book.id}/`}>
                        {book.data.title}
                      </a>

                      <span>by {book.data.author}</span>

                      <StarRating rating={book.data.rating} />
                    </div>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .books-container {
    max-width: 80ch;
    margin: 1rem auto;
  }

  .books-title {
    display: block;
    text-align: center;
    font-family: "Londrina Outline", system-ui;
  }

  .year-header {
    color: white;
  }

  .books-content {
    margin: 0 auto;
    padding: 2rem;
    background-color: #4b352a;
    border: 5px solid #3a2921;
    border-radius: 10px;
  }

  .books-content ul {
    list-style: none;
  }

  .books-content li {
    color: #faebd7;
    font-size: 1.2rem;
    margin: 0.5rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #6b4f3f;
  }

  .books-content li:last-child {
    border-bottom: none;
  }

  .book-title {
    color: #f8c98a;
    font-weight: bold;
    text-decoration: none;
  }

  .book-title:hover {
    color: #df835f;
  }

  @media screen and (max-width: 900px) {
    .line-content {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
  }
</style>
