---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { tagColors } from "../scripts/tagColors";

const { frontmatter, headings } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} class="post" {tagColors}>
  <div class="page-wrapper">
    <section class="content">
      <h1>{frontmatter.title}</h1>
      <p>
        Published on: {
          frontmatter.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </p>
      <div class="tags">
        {
          frontmatter.tags.map((tag: string) => {
            const color = tagColors[tag] || tagColors.default;
            return (
              <a
                href={`/tags/${tag}`}
                class="tag"
                style={`--tag-color: ${color};`}
              >
                {tag}
              </a>
            );
          })
        }
      </div>
      <section class="markdown">
        <slot />
      </section>
    </section>
    <aside class="toc">
      <TableOfContents {headings} />
    </aside>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    display: grid;
    grid-template-columns: 1fr 250px;
    gap: 2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    margin: 0.25em;
    border-radius: 0.5em;
    border: 2px solid var(--tag-color);
    padding: 0.5em 1em;
    font-size: 1em;
    background-color: #f8fcfd;
    text-decoration: none;
  }

  .post {
    max-width: 80ch;
  }

  :global(.markdown h1) {
    color: #8e4897;
    scroll-margin-top: 4rem;
  }

  :global(.markdown h2) {
    color: #508159;
    scroll-margin-top: 4rem;
  }

  :global(.markdown h3) {
    color: #d8b168;
    scroll-margin-top: 4rem;
  }

  :global(.markdown img) {
    width: 100%;
    height: 350px;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
  }

  @media screen and (max-width: 650px) {
    .toc {
      display: none;
    }

    .page-wrapper {
      grid-template-columns: 1fr;
      margin: 0 1rem;
    }
  }
</style>
