---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} class="books">
  <div class="page-wrapper">
    <section class="content">
      <h1>
        {frontmatter.title}
        <span class="author">{frontmatter.author}</span> 📖
      </h1>
      <p>
        {
          frontmatter.fullDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </p>
      <section class="markdown">
        <slot />
      </section>
    </section>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: 80ch;
    margin: 0 auto;
    background-color: #f8f4ee;
    padding: 2rem;
    border: 4px solid #bad6fd;
    border-radius: 20px;
  }

  .books {
    color: #000000;
  }

  .author {
    font-size: 1.5rem;
    font-weight: normal;
    color: #555555;
  }
</style>
